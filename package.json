{
  "name": "llmsocial",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的多账号社媒收件箱 + 多 LLM 对话助理（AI 起草/自动回复，强制 AI 身份披露）",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch-path=src/server --watch-path=src/shared src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/ensure-web-build.ts && node scripts/serve.ts",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "npm run typecheck && npm test",
    "backup": "node scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
