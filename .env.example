# 全部可选。默认只监听本机回环地址。
LLMSOCIAL_HOST=127.0.0.1
LLMSOCIAL_PORT=8787
# Webhook 专用端口：隧道（Cloudflare Tunnel 等）只应该暴露这个端口，不要暴露管理端口。
LLMSOCIAL_WEBHOOK_PORT=8788
# Webhook 端口听在哪。留空 = 0.0.0.0（别的电脑上的桥也能推进来）；只在这台电脑上用（包括本机的隧道、微信聊天桥）可以写 127.0.0.1，Windows 就不会弹防火墙询问。
LLMSOCIAL_WEBHOOK_HOST=
# 对外可达的 webhook 基址（隧道域名），用于在界面里显示回调 URL。
LLMSOCIAL_PUBLIC_WEBHOOK_URL=
# 微信聊天桥（Windows）：装到哪、从哪下载。默认 %LOCALAPPDATA%\Programs\WeChatBridge 和 src/server/config.ts 里钉死的那个 GitHub 发布版本。
LLMSOCIAL_WECHAT_BRIDGE_DIR=
LLMSOCIAL_WECHAT_BRIDGE_URL=
# 「检查更新」去哪个 GitHub 仓库看最新发布，默认 macaumuse-organization/llmsocial。只有在界面上点按钮时才联网。
LLMSOCIAL_RELEASES_REPO=
LLMSOCIAL_DATA_DIR=./data
# 主密钥（base64 的 32 字节）。不设时 macOS 自动存取钥匙串 llmsocial.master-key，其它系统落到 data/master.key（0600）。
LLMSOCIAL_MASTER_KEY=
LOG_LEVEL=info

# 代理（要开 VPN 才能上 Google、X、Instagram 时用）不在这里配：去「设置 → 网络代理」开关，保存立刻生效。
# 下面几行只在第一次启动时读一次——设置里还没存过代理，就把这里的地址搬过去并打开开关；
# 之后一律以设置页为准，这里再改也不会读。
# HTTPS_PROXY=http://127.0.0.1:端口
# HTTP_PROXY=http://127.0.0.1:端口
# NO_PROXY=localhost,127.0.0.1,::1,.aliyuncs.com,.qq.com,.deepseek.com,.moonshot.cn,.bigmodel.cn
