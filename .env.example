# 全部可选。默认只监听本机回环地址。
LLMSOCIAL_HOST=127.0.0.1
LLMSOCIAL_PORT=8787
# Webhook 专用端口：隧道（Cloudflare Tunnel 等）只应该暴露这个端口，不要暴露管理端口。
LLMSOCIAL_WEBHOOK_PORT=8788
# 对外可达的 webhook 基址（隧道域名），用于在界面里显示回调 URL。
LLMSOCIAL_PUBLIC_WEBHOOK_URL=
LLMSOCIAL_DATA_DIR=./data
# 主密钥（base64 的 32 字节）。不设时 macOS 自动存取钥匙串 llmsocial.master-key，其它系统落到 data/master.key（0600）。
LLMSOCIAL_MASTER_KEY=
LOG_LEVEL=info

# 这台电脑要开 VPN / 代理才能上 Google、X、Instagram 时填这里（浏览器能上不代表程序能上：
# 浏览器自动走 Windows 系统代理，Node 不走，也默认不认 HTTPS_PROXY）。
# 代理地址看 Windows「设置 → 网络和 Internet → 代理」里的「地址」和「端口」。
# 改完要重启 llmsocial：代理是程序启动那一刻定下来的。需要 Node 24.5 或更新；设 NODE_USE_ENV_PROXY=0 可以关掉。
# HTTPS_PROXY=http://127.0.0.1:端口
# HTTP_PROXY=http://127.0.0.1:端口
# 下面这些不走代理，直连：本机、国内服务。这样 VPN 关掉时千问、微信照样能用，只有海外平台会断。
# NO_PROXY=localhost,127.0.0.1,::1,.aliyuncs.com,.qq.com,.deepseek.com,.moonshot.cn,.bigmodel.cn
